---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/landing.css';
import {
  apps,
  buildSteps,
  concerns,
  defaultSource,
  flowFacts,
  flowNodes,
  heroSteps,
  includes,
  measured,
  personas,
  roles,
  sampleCall,
  segments,
  sources,
  stats,
  tabs,
} from '../lib/data';

const startSource = sources.find((s) => s.id === defaultSource) ?? sources[0];
const nodes = [
  { app: startSource.label.toUpperCase(), icon: startSource.icon, label: startSource.trigger, mock: false, first: true },
  ...flowNodes.map((n) => ({ ...n, mock: !!n.mock, first: false })),
];
const delay = (i: number, step: number, base = 0) => `${(base + i * step).toFixed(2)}s`;
---

<Layout
  title="Offer Studio · Gaius-Lex · Your tailored offer in under a minute"
  description="Private AI for law firms, in-house legal teams and public administration. Tell Gaius who you are and get the offer our sales team would write for you, matched to your role and concerns."
>
  <Topbar home />

  <main>
    <!-- 1 · Generator -->
    <section id="generator" class="section section--white">
      <div class="wrap hero">
        <div class="hero__copy">
          <span class="eyebrow rise">Private AI for law firms, in-house legal and public administration.</span>
          <h1 class="hero__title rise" style="animation-delay: .1s">Your tailored offer in under a minute<span class="dot">.</span></h1>
          <p class="hero__lead rise" style="animation-delay: .2s">
            Tell Gaius who you are. It builds the offer our sales team would write for you, matched to your role and to
            the concerns your organisation has about AI.
          </p>

          <div class="segments rise" style="animation-delay: .25s">
            <span class="overline overline--muted">We write offers for</span>
            <ul class="segments__list">
              {segments.map((sg) => (
                <li class:list={['segment', { 'segment--soon': sg.soon }]}>
                  <Icon name={sg.icon} size={16} stroke={sg.soon ? 'currentColor' : '#9b5155'} />{sg.label}
                  {sg.soon && <span class="soon">Coming soon</span>}
                </li>
              ))}
            </ul>
          </div>

          <ol class="hero__steps">
            {heroSteps.map((h, i) => (
              <li class="rise" style={`animation-delay: ${delay(i, 0.1, 0.3)}`}>
                <span class="tile tile--soft"><Icon name={h.icon} /></span>
                <span>{h.text}</span>
              </li>
            ))}
          </ol>

          <div class="apps">
            <span class="overline overline--muted">Connected to</span>
            <ul class="apps__list">
              {apps.map((a, i) => (
                <li class="app floaty" style={`animation-delay: ${delay(i, 0.35)}`}>
                  <span class="app__tile"><Icon name={a.icon} size={22} /></span>
                  <span class="app__label">{a.label}</span>
                </li>
              ))}
            </ul>
          </div>

          <a class="callout lift" href="#flow">
            <span class="tile tile--ink tile--36"><Icon name="workflow" size={18} /></span>
            <span><b>No form needed.</b> In daily work it runs on its own: emails, Fireflies transcripts and Gaius Meet notes go through n8n into our CRM.</span>
          </a>

          <p class="fineprint">
            <Icon name="shield" size={16} />
            We use only what you type or say here. No profile lookups, no scraping. This demo runs on sample data.
          </p>
        </div>

        <div class="gen rise" style="animation-delay: .25s" data-generator>
          <div class="gen__tabs" role="tablist" aria-label="How to start">
            {tabs.map((t, i) => (
              <button
                class="gen__tab"
                role="tab"
                id={`tab-${t.id}`}
                aria-controls={`panel-${t.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-tab={t.id}
                type="button"
              >
                <Icon name={t.icon} size={18} />{t.label}
              </button>
            ))}
          </div>

          <div class="gen__body">
            <div class="gen__panel" role="tabpanel" id="panel-email" aria-labelledby="tab-email" data-panel="email">
              <div class="field rise">
                <label for="email" class="field__label">Work email</label>
                <div class="field__control">
                  <Icon name="mail" size={18} />
                  <input id="email" type="email" autocomplete="email" placeholder="anna.nowak@yourfirm.pl" />
                </div>
              </div>
              <div class="field rise" style="animation-delay: .1s">
                <span class="field__label">Or try it as</span>
                <div class="chips">
                  {personas.map((p, i) => (
                    <button class="chip lift" type="button" data-persona={p.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                      <Icon name="building" size={16} stroke="#9b5155" />{p.label}
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <div class="gen__panel" role="tabpanel" id="panel-voice" aria-labelledby="tab-voice" data-panel="voice" hidden>
              <div class="voice rise" data-recording="false">
                <button class="voice__btn" type="button" aria-label="Start recording" data-rec>
                  <Icon name="mic" size={24} />
                </button>
                <div class="voice__text">
                  <span class="voice__title" data-rec-title>Tap to record a voice note</span>
                  <div class="voice__wave" aria-hidden="true">
                    {Array.from({ length: 12 }, (_, i) => <span class="wave" style={`animation-delay: ${delay(i, 0.08)}`}></span>)}
                  </div>
                  <span class="voice__hint">Say who you are, what your team does and what worries you about AI. Up to 30 seconds.</span>
                </div>
              </div>
              <div class="transcript" data-transcript data-state="empty" hidden>
                <div class="transcript__body">
                  <span class="transcript__label" data-transcript-label>Live transcript</span>
                  <p class="transcript__text" data-transcript-text aria-live="polite"></p>
                  <textarea class="transcript__edit" data-transcript-edit rows="4" aria-label="Edit the transcript" hidden></textarea>
                </div>
                <button class="transcript__btn" type="button" data-transcript-btn aria-label="Edit the transcript" title="Edit the transcript" hidden>
                  <Icon name="pencil" size={18} class="transcript__icon-edit" />
                  <Icon name="check" size={18} strokeWidth={2.5} class="transcript__icon-save" />
                </button>
              </div>
              <p class="fineprint fineprint--tight">Your note is transcribed and used for this offer only.</p>
            </div>

            <div class="gen__panel" role="tabpanel" id="panel-text" aria-labelledby="tab-text" data-panel="text" hidden>
              <div class="field rise">
                <label for="call-text" class="field__label">Paste an email or a call transcript</label>
                <textarea id="call-text" class="paste" rows="7" data-call-text placeholder="Paste the email, the Fireflies transcript or your call notes. Polish or English."></textarea>
              </div>
              <div class="paste__tools">
                <label class="btn btn--outline btn--sm paste__file">
                  <Icon name="file" size={16} />Load a file<input type="file" accept=".txt,.md,.vtt,.srt,.json,text/plain" data-call-file hidden />
                </label>
                <button class="btn btn--outline btn--sm" type="button" data-call-sample><Icon name="quote" size={16} />Use a sample call</button>
                <span class="paste__count" data-call-count></span>
              </div>
              <p class="fineprint fineprint--tight"><Icon name="shield" size={16} />Remove client names before pasting. The text is used for this offer only.</p>
            </div>

            <div class="gen__panel" role="tabpanel" id="panel-role" aria-labelledby="tab-role" data-panel="role" hidden>
              <span class="field__label">Which seat do you sit in?</span>
              <div class="role-grid">
                {roles.map((r, i) => (
                  <button
                    class:list={['role-pick rise', { lift: !r.soon }]}
                    type="button"
                    data-role={r.id}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                    disabled={r.soon}
                    style={`animation-delay: ${delay(i, 0.06)}`}
                  >
                    <Icon name={r.icon} stroke={r.soon ? 'currentColor' : '#9b5155'} />{r.label}
                    {r.soon && <span class="soon">Coming soon</span>}
                  </button>
                ))}
              </div>
            </div>

            <button class="btn btn--ink btn--block nudge" type="button" data-generate>
              <Icon name="spark" size={18} />Generate my offer<Icon name="arrow" size={18} />
            </button>
          </div>

          <div class="gen__result">
            <div data-phase="idle">
              <span class="overline">Your offer will include</span>
              <div class="includes">
                {includes.map((inc, i) => (
                  <div class="include rise" style={`animation-delay: ${delay(i, 0.08)}`}>
                    <Icon name={inc.icon} stroke="#9b5155" />{inc.text}
                  </div>
                ))}
              </div>
            </div>

            <div data-phase="working" aria-live="polite" hidden>
              <span class="overline">Building your offer</span>
              <ol class="build-steps">
                {buildSteps.map((label, i) => (
                  <li class="build-step" data-build-step={i} data-state="waiting">
                    <span class="build-step__mark">
                      <Icon name="spinner" size={16} strokeWidth={2.5} class="spin mark-active" />
                      <Icon name="check" size={16} strokeWidth={2.5} class="mark-done" />
                      <span class="mark-waiting">{i + 1}</span>
                    </span>
                    {label}
                  </li>
                ))}
              </ol>
            </div>

            <div data-phase="done" hidden>
              <article class="offer rise">
                <div class="offer__head">
                  <span class="overline"><span>Offer for <span data-offer="who"></span></span></span>
                  <div class="offer__tiles" data-offer-tiles hidden></div>
                  <h2 class="offer__title" data-offer="headline"></h2>
                  <span class="offer__meta"><Icon name="clock" size={14} /><span data-offer-meta>Generated in 2 min 41 s · sample data</span></span>
                  <span class="offer__saved slidein" style="animation-delay: .4s"><Icon name="check" size={14} strokeWidth={2.5} /><span data-offer-saved>Saved to CRM · alert posted to #sales on Discord (mock)</span></span>
                </div>
                <details class="understood" data-understood open hidden>
                  <summary>How Gaius read your note <span class="understood__hint">check it here</span></summary>
                  <div class="understood__grid">
                    <div>
                      <span class="understood__label">What it heard</span>
                      <p class="understood__heard" data-u-heard></p>
                    </div>
                    <div>
                      <span class="understood__label">Who it thinks you are</span>
                      <ul class="understood__list" data-u-who></ul>
                      <span class="understood__label">Concerns it found</span>
                      <ul class="understood__list" data-u-pains></ul>
                    </div>
                  </div>
                </details>
                <div class="offer__block">
                  <span class="offer__label" data-concerns-label>What you told us worries you</span>
                  <div data-offer-concerns>
                    <div class="offer__line slidein" style="animation-delay: .15s"><Icon name="alert" size={18} stroke="#ce5e64" />Picking a tool that does not fit and leaves the team frustrated.</div>
                    <div class="offer__line slidein" style="animation-delay: .25s"><Icon name="lock" size={18} stroke="#ce5e64" />Client documents leaking, with no one accountable.</div>
                  </div>
                  <template data-concern-tpl>
                    <div class="offer__line slidein"><Icon name="alert" size={18} stroke="#ce5e64" /><span></span></div>
                  </template>
                </div>
                <div class="offer__block">
                  <span class="offer__label">How Gaius answers</span>
                  <div class="offer__line slidein" style="animation-delay: .35s"><Icon name="check" size={18} stroke="#2e7d46" strokeWidth={2.5} />Every answer leads to its basis: the provision, the judgment, the quote, the case number.</div>
                  <div class="offer__line slidein" style="animation-delay: .45s"><Icon name="check" size={18} stroke="#2e7d46" strokeWidth={2.5} /><span data-offer="product-line"></span></div>
                  <div class="offer__line slidein" style="animation-delay: .55s"><Icon name="check" size={18} stroke="#2e7d46" strokeWidth={2.5} /><span data-offer="answer"></span></div>
                </div>
                <div class="offer__foot">
                  <div class="offer__attach">
                    <span class="offer__meta">Attached for your team</span>
                    <span class="offer__file"><Icon name="file" size={16} stroke="#9b5155" /><span data-offer="attach"></span></span>
                    <span class="offer__price">Pilot: up to 14 days, unlimited accounts for the team</span>
                  </div>
                  <div class="offer__actions">
                    <button class="btn btn--ink btn--sm" type="button" data-offer-view hidden><Icon name="eye" size={16} />View the deck</button>
                    <a class="btn btn--outline btn--sm" data-offer-pdf target="_blank" rel="noopener" aria-disabled="true"><Icon name="download" size={16} />Download PDF</a>
                    <a class="btn btn--outline btn--sm" href="https://gaius-lex.pl" target="_blank" rel="noopener"><Icon name="calendar" size={16} />Book a demo</a>
                  </div>
                </div>
                <details class="offer__note" data-offer-note hidden>
                  <summary><Icon name="chat" size={16} stroke="#9b5155" />What our sales team gets with it</summary>
                  <p data-offer-note-text></p>
                  <span class="offer__meta">Written in Polish for the Gaius-Lex sales team, as it arrives in #sales.</span>
                </details>
              </article>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · Flow -->
    <section id="flow" class="section section--sand section--bordered">
      <div class="wrap stack-40">
        <div class="flow__intro reveal">
          <div class="section-head">
            <span class="overline"><Icon name="workflow" size={16} />AI-native sales, end to end</span>
            <h2 class="h2">From the first conversation to the CRM, with no one retyping anything.</h2>
            <p class="lead">An email arrives or a meeting ends. n8n picks it up, Offer Studio writes the offer, the opportunity lands in our CRM and the team gets a ping on Discord.</p>
            <p class="flow__live"><Icon name="spark" size={16} stroke="#9b5155" />This runs the production workflow on the sample below. The deck and the team note are real; the CRM and Discord delivery are mocked.</p>
          </div>
          <button class="btn btn--ink btn--lg pulse" type="button" data-run-flow>
            <Icon name="play" size={18} /><span data-run-flow-label>Run the workflow</span>
          </button>
        </div>

        <div class="flow" data-flow>
          <div class="flow__col flow__col--sources">
            <span class="overline overline--muted">1 · Something comes in</span>
            {sources.map((src) => (
              <button class="source lift reveal" type="button" data-src={src.id} aria-pressed={src.id === startSource.id ? 'true' : 'false'}>
                <span class="source__tile"><Icon name={src.icon} size={22} /></span>
                <span class="source__text">
                  <span class="source__label">{src.label}</span>
                  <span class="source__desc">{src.desc}</span>
                </span>
              </button>
            ))}
          </div>

          <div class="flow__col flow__col--nodes">
            <span class="overline overline--muted">2 · n8n workflow runs</span>
            <div class="workflow reveal">
              <div class="workflow__head">
                <span class="workflow__name"><Icon name="workflow" size={18} stroke="#9b5155" />n8n · offer-studio</span>
                <span class="workflow__status" data-flow-status data-state="waiting"><span class="workflow__dot"></span><span data-flow-status-text>Waiting for a trigger</span></span>
              </div>
              <ol class="workflow__nodes" aria-live="polite">
                {nodes.map((n, i) => (
                  <>
                    <li class="node" data-node={i} data-state="idle">
                      <span class="node__dot"><Icon name={n.icon} size={18} data-node-icon={n.first ? '' : undefined} /></span>
                      <span class="node__text">
                        <span class="node__app" data-node-app={n.first ? '' : undefined}>{n.app}</span>
                        <span class="node__label" data-node-label={n.first ? '' : undefined}>{n.label}</span>
                      </span>
                      {n.mock && <span class="node__mock">MOCK</span>}
                      <Icon name="check" size={18} stroke="#2e7d46" strokeWidth={2.5} class="node__check" />
                    </li>
                    {i < nodes.length - 1 && <li class="node-link" aria-hidden="true"></li>}
                  </>
                ))}
              </ol>
            </div>
          </div>

          <div class="flow__col flow__col--out">
            <span class="overline overline--muted">3 · The team knows</span>
            <div class="flow__placeholder" data-flow-empty>
              <span class="tile tile--white tile--56 floaty"><Icon name="bell" size={26} /></span>
              <span class="flow__placeholder-title">Discord alert and CRM card appear here.</span>
              <span class="flow__placeholder-hint">Pick a source and run the workflow.</span>
            </div>
            <div class="flow__out" data-flow-out hidden>
              <details class="flow__sample" open>
                <summary>What came in</summary>
                <p data-flow-sample>{startSource.sample}</p>
              </details>
              <div class="discord slidein">
                <span class="discord__avatar"><Icon name="spark" /></span>
                <div class="discord__body">
                  <span class="discord__meta"><b>Offer Studio</b> <span class="discord__bot">BOT</span> <span class="discord__time">#sales · today 09:41</span></span>
                  <span class="discord__strong">New offer ready for <b data-flow-who>{startSource.who}</b></span>
                  <span>Source: <span data-flow-source>{startSource.short}</span>. Opportunity moved to <b class="discord__hl">Offer</b>. Offer PDF attached.</span>
                  <span class="discord__tiles" data-flow-tiles hidden></span>
                  <span class="discord__note" data-flow-note hidden></span>
                  <span class="discord__actions">
                    <button class="discord__link" type="button" data-flow-view hidden><Icon name="file" size={14} />Open the deck</button>
                    <span class="discord__link">Open in CRM<Icon name="arrow" size={14} /></span>
                  </span>
                </div>
              </div>
              <div class="crm slidein" style="animation-delay: .2s">
                <span class="crm__kicker"><Icon name="db" size={14} />CRM · OPPORTUNITY</span>
                <span class="crm__who" data-flow-who>{startSource.who}</span>
                <div class="crm__stages">
                  <span>New</span><span>Trial</span><span class="is-current pulse">Offer</span><span>Won</span>
                </div>
                <span class="crm__next"><Icon name="calendar" size={16} stroke="#9b5155" />Offer attached · next activity: follow-up call in 2 days · owner: sales team</span>
              </div>
            </div>
          </div>
        </div>

        <div class="facts">
          {flowFacts.map((f) => (
            <div class="fact reveal">
              <span class="tile tile--soft"><Icon name={f.icon} /></span>
              <span class="fact__title">{f.title}</span>
              <span class="fact__text">{f.text}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3 · Fears -->
    <section id="fears" class="section section--ink">
      <div class="wrap stack-48">
        <div class="section-head reveal">
          <span class="overline overline--on-ink">Why offers have to be personal</span>
          <h2 class="h2">Two fears stand behind every AI purchase: FOMU and FOBO.</h2>
          <p class="lead lead--on-ink">With AI slop everywhere, a generic offer answers neither. Each buyer weighs them differently, so each offer has to show we understood their need.</p>
        </div>
        <div class="fears">
          <div class="fear reveal">
            <div class="fear__top"><span class="fear__num">FOMU</span><span class="tile tile--raised tile--56 floaty"><Icon name="alert" size={28} /></span></div>
            <h3 class="fear__title">Fear of messing up.</h3>
            <p class="fear__text">AI is new for most legal teams. A poor pick means wasted budget, a team that stops trying, or client documents leaking with no one accountable.</p>
            <p class="fear__answer"><Icon name="check" stroke="#7fd79a" strokeWidth={2.5} />Gaius answer: see it work on your own case first, with your data on your servers and one team accountable for it.</p>
          </div>
          <div class="fear reveal">
            <div class="fear__top"><span class="fear__num">FOBO</span><span class="tile tile--raised tile--56 floaty" style="animation-delay: .6s"><Icon name="trend" size={28} /></span></div>
            <h3 class="fear__title">Fear of a better option.</h3>
            <p class="fear__text">A new model every month and AI in every tool. Waiting for something better feels safer than choosing now.</p>
            <p class="fear__answer"><Icon name="check" stroke="#7fd79a" strokeWidth={2.5} />Gaius answer: a pilot on your own matters, so the decision rests on your results, not on a brochure.</p>
          </div>
        </div>
        <div class="concerns">
          {concerns.map((c) => (
            <div class="concern reveal lift">
              <span class="concern__icon"><Icon name={c.icon} size={24} /></span>
              <span class="concern__title">{c.title}</span>
              <span class="concern__text">{c.text}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4 · Roles -->
    <section id="roles" class="section section--sand">
      <div class="wrap stack-48">
        <div class="section-head reveal">
          <span class="overline">Two narratives today</span>
          <h2 class="h2">Written for the person who brings Gaius in, or the board that signs.</h2>
          <p class="lead">A champion needs something to show the team on Monday. A board needs one accountable partner and a plan. The other seats get their own documents soon.</p>
        </div>
        <div class="role-cards">
          {roles.map((r) => (
            <div class:list={['role-card reveal', { 'role-card--soon': r.soon }]}>
              <span class="role-card__top">
                <span class="tile tile--soft tile--48"><Icon name={r.icon} size={24} /></span>
                {r.soon && <span class="soon">Coming soon</span>}
              </span>
              <h3 class="role-card__title">{r.label}</h3>
              <span class="role-card__label">Cares about</span>
              <span class="role-card__text">{r.cares}</span>
              <span class="role-card__label role-card__label--rule">Gets</span>
              <span class="role-card__gets"><Icon name="file" size={18} stroke="#9b5155" />{r.gets}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5 · Results -->
    <section id="results" class="section section--white">
      <div class="wrap stack-48">
        <div class="section-head reveal">
          <span class="overline">Measured result</span>
          <h2 class="h2">Measured against how we sell today.</h2>
        </div>
        <div class="stats">
          {stats.map((st, i) => (
            <div class="stat reveal">
              <span class="tile tile--ink tile--48 floaty" style={`animation-delay: ${delay(i, 0.5)}`}><Icon name={st.icon} size={24} /></span>
              <span class="stat__label">{st.label}</span>
              <span class:list={['stat__before', { 'is-struck': st.strike }]}>{st.before}</span>
              <span class="stat__after">{st.after}</span>
              <span class="stat__note">{st.note}</span>
            </div>
          ))}
        </div>
        <p class="live-run" data-live-run hidden><Icon name="clock" size={16} /><span data-live-run-text></span></p>
        <p class="fineprint">
          After: measured on {measured.decks} decks from the production n8n workflow, {measured.from?.slice(0, 10)} to {measured.to?.slice(0, 10)}, {measured.failed} failed runs.
          Before: the Gaius-Lex sales team, November 2026. Re-measure with <code>node scripts/measure.mjs</code>.
        </p>
      </div>
    </section>
  </main>

  <dialog class="deck" data-deck aria-label="Your offer deck">
    <div class="deck__bar">
      <span class="deck__title" data-deck-title>Your offer</span>
      <a class="btn btn--outline btn--sm" data-deck-download><Icon name="download" size={16} />Download PDF</a>
      <button class="btn btn--ink btn--sm" type="button" data-deck-close>Close</button>
    </div>
    <iframe class="deck__frame" data-deck-frame title="Offer deck (PDF)"></iframe>
  </dialog>

  <Footer />
</Layout>

<script>
  import { icons } from '../lib/icons';
  import { personas, roles, sources, buildSteps, flowNodes, pains, sampleCall } from '../lib/data';

  // Every "Generate my offer" click posts the form here (override with PUBLIC_OFFER_WEBHOOK_URL at build time).
  const OFFER_WEBHOOK_URL = String(import.meta.env.PUBLIC_OFFER_WEBHOOK_URL || 'https://n8n.bizhack.trygaius.com/webhook/dd7c4b67-f5f6-40f4-9325-1ca924d5ff78');
  const N8N_ORIGIN = new URL(OFFER_WEBHOOK_URL).origin;

  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel as string) as T | null;
  const $$ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => Array.from(root.querySelectorAll<T>(sel as string)) as T[];

  /* ---------- Offer generator ---------- */
  const state = { mode: 'email', persona: personas[0].id, role: roles[0].id, rec: false };
  // What the visitor actually clicked (preselected defaults do not count).
  const touched = { persona: false, role: false };

  // "Paste a call": an email, a transcript or notes, typed, pasted or loaded from a file.
  const callBox = $<HTMLTextAreaElement>('[data-call-text]')!;
  const callCount = $('[data-call-count]')!;
  const callText = () => callBox.value.trim();
  const showCount = () => {
    const n = callText().length;
    callCount.textContent = n ? `${n.toLocaleString('en')} characters` : '';
  };
  callBox.addEventListener('input', showCount);
  $('[data-call-sample]')?.addEventListener('click', () => {
    callBox.value = sampleCall;
    showCount();
    callBox.focus();
  });
  // A Fireflies JSON export becomes "Speaker: sentence" lines; anything else is read as text.
  const fromFile = (raw: string) => {
    try {
      const j = JSON.parse(raw);
      const t = j?.data?.transcript || j?.transcript || j;
      const lines = (t?.sentences || []).map((x: any) => `${x.speaker_name || x.speaker || ''}: ${x.text || x.raw_text || ''}`);
      const overview = t?.summary?.overview;
      if (lines.length || overview) return [t.title, overview, lines.join('\n')].filter(Boolean).join('\n\n');
    } catch { /* not JSON */ }
    return raw;
  };
  $<HTMLInputElement>('[data-call-file]')?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    callBox.value = fromFile(await file.text()).slice(0, 20000);
    (e.target as HTMLInputElement).value = '';
    showCount();
  });
  let genTimers: number[] = [];
  let genRun = 0;

  const showPhase = (phase: 'idle' | 'working' | 'done') => {
    $$('[data-phase]').forEach((el) => (el.hidden = el.dataset.phase !== phase));
  };
  const resetGen = () => {
    genRun++;
    genTimers.forEach(clearTimeout);
    genTimers = [];
    showPhase('idle');
  };

  const tabButtons = $$<HTMLButtonElement>('[data-tab]');
  const selectTab = (id: string, focus = false) => {
    state.mode = id;
    tabButtons.forEach((b) => {
      const on = b.dataset.tab === id;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
      if (on && focus) b.focus();
    });
    $$('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
    resetGen();
  };
  tabButtons.forEach((b, i) => {
    b.addEventListener('click', () => selectTab(b.dataset.tab!));
    b.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabButtons[(i + (e.key === 'ArrowRight' ? 1 : -1) + tabButtons.length) % tabButtons.length];
      selectTab(next.dataset.tab!, true);
    });
  });

  const pressGroup = (attr: string, key: 'persona' | 'role') => {
    const buttons = $$<HTMLButtonElement>(`[${attr}]`);
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        state[key] = b.getAttribute(attr)!;
        touched[key] = true;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        resetGen();
      }),
    );
  };
  pressGroup('data-persona', 'persona');
  pressGroup('data-role', 'role');

  // Voice note: a real recording from the microphone (up to 30 s), sent to n8n as base64 audio,
  // plus a live transcript from the browser's speech recognition that the visitor can correct.
  // Without a microphone (or permission) the visitor can type the note; otherwise the sample is sent.
  const MAX_REC_S = 30;
  const voice = {
    audio: null as string | null,
    mimeType: null as string | null,
    seconds: 0,
    error: null as string | null,
    transcript: '',
    edited: false,
    recognitionError: null as string | null,
  };
  // Resolves when the last recording is converted and ready to send.
  let voiceReady: Promise<void> = Promise.resolve();
  const recBtn = $<HTMLButtonElement>('[data-rec]');
  const recTitle = $('[data-rec-title]');
  const tBox = $('[data-transcript]')!;
  const tText = $('[data-transcript-text]')!;
  const tLabel = $('[data-transcript-label]')!;
  const tEdit = $<HTMLTextAreaElement>('[data-transcript-edit]')!;
  const tBtn = $<HTMLButtonElement>('[data-transcript-btn]')!;
  const fmt = (s: number) => {
    const t = Math.max(0, Math.floor(s));
    return `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`;
  };
  const setRecUi = (on: boolean, title: string) => {
    state.rec = on;
    recBtn!.closest<HTMLElement>('.voice')!.dataset.recording = String(on);
    recBtn!.setAttribute('aria-label', on ? 'Stop recording' : 'Start recording');
    recTitle!.textContent = title;
  };
  const blobToBase64 = (blob: Blob) =>
    new Promise<string>((ok, fail) => {
      const r = new FileReader();
      r.onload = () => ok(String(r.result).split(',')[1] || '');
      r.onerror = () => fail(r.error);
      r.readAsDataURL(blob);
    });

  // ---- transcript box
  const renderTranscript = (finalText: string, interim = '') => {
    tText.textContent = finalText;
    if (interim) {
      const span = document.createElement('span');
      span.className = 'interim';
      span.textContent = (finalText ? ' ' : '') + interim;
      tText.append(span);
    }
  };
  const showFinalTranscript = () => {
    // A preview: n8n transcribes the recording itself; only a text corrected with the pencil is used as it is.
    tLabel.textContent = voice.edited ? 'Your corrected note' : 'Transcript preview · tap the pencil to correct it';
    renderTranscript(voice.transcript);
    if (!voice.transcript) {
      tText.textContent = voice.recognitionError
        ? 'Live transcript is not available in this browser. Tap the pencil to type your note.'
        : 'We did not catch any words. Tap the pencil to type your note.';
    }
  };
  const finishEditing = () => {
    if (tBox.dataset.state !== 'editing') return;
    const value = tEdit.value.trim();
    if (value !== voice.transcript) voice.edited = true;
    voice.transcript = value;
    tEdit.hidden = true;
    tText.hidden = false;
    tBox.dataset.state = 'ready';
    tBtn.setAttribute('aria-label', 'Edit the transcript');
    tBtn.title = 'Edit the transcript';
    showFinalTranscript();
  };
  tBtn.addEventListener('click', () => {
    if (tBox.dataset.state === 'editing') return finishEditing();
    tBox.dataset.state = 'editing';
    tEdit.value = voice.transcript;
    tText.hidden = true;
    tEdit.hidden = false;
    tBtn.setAttribute('aria-label', 'Save the transcript');
    tBtn.title = 'Save the transcript';
    tEdit.focus();
    tEdit.setSelectionRange(tEdit.value.length, tEdit.value.length);
  });
  tEdit.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) finishEditing();
  });

  // ---- live speech recognition (Chrome, Edge, Safari). Other browsers: audio only, type by hand.
  type Recognition = {
    lang: string; continuous: boolean; interimResults: boolean;
    start(): void; stop(): void; abort(): void;
    onresult: ((e: any) => void) | null; onend: (() => void) | null; onerror: ((e: any) => void) | null;
  };
  const SpeechRec = ((window as any).SpeechRecognition || (window as any).webkitSpeechRecognition) as (new () => Recognition) | undefined;

  // One recording session at a time: the timer, recorder, stream and recognition live together.
  type Session = {
    id: number;
    started: number;
    timer: number;
    stream: MediaStream;
    recorder: MediaRecorder;
    chunks: Blob[];
    recognition: Recognition | null;
    finals: string[];
    interim: string;
    stopping: boolean;
    done: () => void;
  };
  let session: Session | null = null;
  let starting = false;
  let sessionSeq = 0;

  const startRecognition = (s: Session) => {
    if (!SpeechRec) {
      voice.recognitionError = 'unsupported';
      tText.textContent = 'Live transcript is not available in this browser. You can type your note after recording.';
      return;
    }
    const r = new SpeechRec();
    // Live preview in Polish (our clients speak Polish; an English browser would turn Polish speech into gibberish).
    // The final text is transcribed from the recording in n8n, which detects the language itself.
    r.lang = 'pl-PL';
    r.continuous = true;
    r.interimResults = true;
    r.onresult = (e) => {
      if (session !== s) return;
      let interim = '';
      for (let i = e.resultIndex; i < e.results.length; i++) {
        const res = e.results[i];
        if (res.isFinal) s.finals.push(res[0].transcript.trim());
        else interim += res[0].transcript;
      }
      s.interim = interim.trim();
      voice.transcript = s.finals.join(' ');
      renderTranscript(voice.transcript, s.interim);
    };
    r.onerror = (e) => {
      // 'no-speech' and 'aborted' are normal; anything else means no live transcript here.
      if (e.error === 'no-speech' || e.error === 'aborted') return;
      voice.recognitionError = String(e.error || 'error');
      if (session === s && !s.stopping) tText.textContent = 'Live transcript is not available here. You can type your note after recording.';
      s.recognition = null;
    };
    // Chrome ends recognition after a pause: restart it while we are still recording.
    r.onend = () => {
      if (session === s && !s.stopping && s.recognition === r) {
        try { r.start(); } catch { /* already running */ }
      }
    };
    s.recognition = r;
    try { r.start(); } catch { s.recognition = null; }
  };

  const finalize = async (s: Session) => {
    if (session !== s) return;
    session = null;
    try { s.recognition?.abort(); } catch { /* not running */ }
    s.stream.getTracks().forEach((t) => t.stop());
    // Keep the words that were still being recognized when the visitor stopped.
    const words = [...s.finals, s.interim].filter(Boolean).join(' ').trim();
    voice.transcript = words;
    const blob = new Blob(s.chunks, { type: s.recorder.mimeType || 'audio/webm' });
    voice.mimeType = blob.type;
    voice.audio = blob.size ? await blobToBase64(blob) : null;
    setRecUi(false, `Recorded ${fmt(voice.seconds)} · tap to record again`);
    tBox.dataset.state = 'ready';
    tBtn.hidden = false;
    showFinalTranscript();
    s.done();
  };

  const stopRecording = () => {
    const s = session;
    if (!s || s.stopping) return;
    s.stopping = true;
    // The timer stops right away, whatever the browser does next.
    clearInterval(s.timer);
    voice.seconds = Math.min(MAX_REC_S, (performance.now() - s.started) / 1000);
    recTitle!.textContent = `Saving ${fmt(voice.seconds)}…`;
    // Let recognition deliver its last results, then wrap up.
    try { s.recognition?.stop(); } catch { /* not running */ }
    s.recorder.onstop = () => setTimeout(() => finalize(s), 400);
    try { s.recorder.state !== 'inactive' ? s.recorder.stop() : finalize(s); } catch { finalize(s); }
    // Safety net: some browsers never fire onstop.
    setTimeout(() => finalize(s), 2000);
  };

  recBtn?.addEventListener('click', async () => {
    if (session) return stopRecording();
    if (starting) return; // the microphone prompt is still open
    finishEditing();
    starting = true;
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      let done = () => {};
      voiceReady = new Promise((ok) => (done = ok));
      Object.assign(voice, { audio: null, mimeType: null, seconds: 0, transcript: '', edited: false, error: null, recognitionError: null });
      const recorder = new MediaRecorder(stream);
      const s: Session = {
        id: ++sessionSeq, started: performance.now(), timer: 0, stream, recorder, chunks: [],
        recognition: null, finals: [], interim: '', stopping: false, done,
      };
      session = s;
      recorder.ondataavailable = (e) => { if (e.data.size) s.chunks.push(e.data); };
      recorder.start(250);
      setRecUi(true, `Recording… ${fmt(0)} / ${fmt(MAX_REC_S)}`);
      tBox.hidden = false;
      tBox.dataset.state = 'recording';
      tBtn.hidden = true;
      tEdit.hidden = true;
      tText.hidden = false;
      tLabel.textContent = 'Live transcript (preview)';
      tText.textContent = 'Listening…';
      startRecognition(s);
      s.timer = window.setInterval(() => {
        const sec = (performance.now() - s.started) / 1000;
        if (sec >= MAX_REC_S) return stopRecording();
        recTitle!.textContent = `Recording… ${fmt(sec)} / ${fmt(MAX_REC_S)}`;
      }, 200);
    } catch (e) {
      voice.error = (e as Error).name || 'microphone unavailable';
      setRecUi(false, 'No microphone access · type your note or the sample note will be sent');
      tBox.hidden = false;
      tBox.dataset.state = 'ready';
      tBtn.hidden = false;
      tLabel.textContent = 'Your note';
      tText.textContent = 'Tap the pencil to type your note.';
    } finally {
      starting = false;
    }
  });

  type LeadResult = {
    offerId: string;
    role: 'champion' | 'board';
    who: string;
    concerns: string[];
    // Either a path on the n8n host, or pdfUrl: the final deck n8n sent back (a blob: URL)
    pdfPath?: string;
    pdfUrl?: string;
    fileName?: string;
    known: boolean;
    ms: number;
    // From the deck's response headers: the tiles Offer Studio built it from, and the note for our sales team
    tiles?: string[];
    note?: string;
    // What the workflow understood from the enquiry (X-Offer-Understood): shown so a voice note is easy to check
    understood?: Understood;
  };
  type Pick = { id: string | null; label: string; why?: string };
  type Understood = { heard?: string; source?: string; role?: Pick; segment?: Pick; product?: Pick; pains?: Pick[]; summary?: string };

  // The text the workflow worked from, without its section headings ("## Transkrypcja…").
  const heardText = (u?: Understood) => String(u?.heard || '').replace(/^##[^\n]*(\n|$)/gm, '').trim();
  // The client's own words behind a concern, without the quote marks the model adds; empty when it had none.
  const saidWords = (p: Pick) => String(p.why || '').replace(/^[\s«»“”„"']+|[\s«»“”„"']+$/g, '').trim();

  // "How Gaius read your note": what the workflow heard and which role, segment, product and concerns it picked, with why.
  const showUnderstood = (u?: Understood) => {
    const box = $<HTMLDetailsElement>('[data-understood]')!;
    box.hidden = !u || !(u.heard || u.pains?.length);
    if (box.hidden || !u) return;
    $('[data-u-heard]')!.textContent = heardText(u) || '(nothing came through: the note was empty or silent)';
    const item = (label: string, why?: string) => {
      const li = document.createElement('li');
      li.append(Object.assign(document.createElement('strong'), { textContent: label }));
      if (why) li.append(Object.assign(document.createElement('span'), { className: 'understood__why', textContent: why }));
      return li;
    };
    const who = ([['Role', u.role], ['Organisation', u.segment], ['Product', u.product]] as const)
      .filter(([, p]) => p?.id).map(([k, p]) => item(`${k}: ${TILE_WORDS[p!.id!] || p!.label}`, p!.why));
    $('[data-u-who]')!.replaceChildren(...who);
    const pains = (u.pains || []).map((p) => item((p.id && TILE_WORDS[p.id]) || p.label, saidWords(p) ? `“${saidWords(p)}”` : 'Not from your words: a default when the note gives nothing to go on.'));
    $('[data-u-pains]')!.replaceChildren(...(pains.length ? pains : [item('None found')]));
  };

  const typedEmail = () => $<HTMLInputElement>('#email')?.value.trim() || '';
  // The landing only collects input; n8n interprets it. We send what the visitor actually gave us and
  // nothing else: no preselected defaults they never touched, no sample text, no guessing.
  // A field is null when the visitor did not use it. `touched` lists what they used.
  const leadPayload = () => {
    const email = typedEmail() || null;
    // "Try it as" counts when a chip was clicked, or when it is what the Email tab submits (no email typed).
    // A pasted call goes alone (a real case must not be mixed with a demo persona or an older voice note).
    const pasted = state.mode === 'text';
    const usedTryItAs = !pasted && (touched.persona || (state.mode === 'email' && !email));
    // A role counts when it was clicked, or when the visitor generates from the Pick your role tab.
    const usedRole = touched.role || state.mode === 'role';
    const usedVoice = !pasted && !!(voice.audio || voice.transcript);
    const text = pasted ? callText() || null : null;
    const p = personas.find((x) => x.id === state.persona) ?? personas[0];
    return {
      source: `landing-${state.mode}`,
      mode: state.mode,
      touched: [email && 'email', usedTryItAs && 'tryItAs', usedRole && 'pickedRole', usedVoice && 'voice', text && 'text'].filter(Boolean),
      email,
      // An email or call transcript the visitor pasted ("Paste a call")
      text,
      // A demo persona: its text is sample copy, not something the visitor wrote.
      tryItAs: usedTryItAs ? { persona: p.id, label: p.label, role: p.role, segment: p.segment, sampleText: p.text } : null,
      pickedRole: usedRole ? state.role : null,
      voice: usedVoice
        ? {
            audioBase64: voice.audio,
            mimeType: voice.mimeType,
            seconds: voice.seconds ? Math.round(voice.seconds * 10) / 10 : null,
            // What was said: the browser's live transcript, corrected by the visitor if they used the pencil
            transcript: voice.transcript || null,
            transcriptEdited: voice.edited,
            // Set when the browser could not transcribe (unsupported, network…): transcribe the audio in n8n
            transcriptionError: voice.recognitionError,
          }
        : null,
      // Microphone problem (e.g. permission denied), even when nothing was recorded
      microphoneError: voice.error,
      page: location.href,
      language: navigator.language,
      sentAt: new Date().toISOString(),
    };
  };

  // Sample offer when n8n is not configured or does not answer.
  const sampleResult = () => {
    if (state.mode === 'voice') return { roleId: 'champion', who: 'In-house legal team · from your voice note' };
    if (state.mode === 'text') return { roleId: 'champion', who: 'From your call' };
    if (state.mode === 'email' && !typedEmail()) {
      const p = personas.find((x) => x.id === state.persona) ?? personas[0];
      return { roleId: p.role, who: p.who };
    }
    const r = roles.find((x) => x.id === state.role) ?? roles[0];
    return { roleId: r.id, who: state.mode === 'email' ? typedEmail() : r.label };
  };

  // Tile ids → words: the landing shows which concerns the offer answers.
  const TILE_WORDS: Record<string, string> = {
    'role:champion': 'Team champion', 'role:board': 'Board', 'segment:law-firm': 'Law firm', 'segment:in-house': 'In-house legal',
    'segment:public-sector': 'Public administration', 'product:saas': 'Gaius-Lex SaaS', 'product:vault': 'Gaius Vault', 'product:on-prem': 'On-premise',
    // pain labels as in Offer Studio (seed/tiles.js)
    'pain:confidentiality': 'Confidentiality', 'pain:shadow-ai': 'Shadow AI', 'pain:repetitive-documents': 'Repetitive documents',
    'pain:board-pressure': 'Board pressure', 'pain:chatgpt-only-informs': 'ChatGPT only informs', 'pain:hallucinated-citations': 'Hallucinated citations',
    'pain:unsearchable-archive': 'Unsearchable archive', 'pain:copy-to-word': 'Copying into Word', 'pain:group-scale': 'Scale across a group',
    'pain:templates-at-scale': 'Templates at scale', 'pain:weak-case-law-search': 'Weak case-law search',
  };
  const tileWord = (t: string) => TILE_WORDS[t] || t.replace(/^pain:/, '').replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase());
  const painLines = (tiles: string[] = []) => tiles.filter((t) => t.startsWith('pain:')).map((t) => pains[t.slice(5)]).filter(Boolean);

  // The deck itself, shown full screen (the browser's PDF viewer) so the room sees what the client gets.
  const deck = $<HTMLDialogElement>('[data-deck]')!;
  const openDeck = (r: LeadResult) => {
    if (!r.pdfUrl) return;
    $<HTMLIFrameElement>('[data-deck-frame]')!.src = `${r.pdfUrl}#view=FitH`;
    $('[data-deck-title]')!.textContent = `Offer for ${r.who}`;
    const dl = $<HTMLAnchorElement>('[data-deck-download]')!;
    dl.href = r.pdfUrl;
    dl.download = r.fileName || 'Gaius-offer.pdf';
    deck.showModal();
  };
  $('[data-deck-close]')?.addEventListener('click', () => deck.close());
  deck.addEventListener('click', (e) => { if (e.target === deck) deck.close(); });
  let lastOffer: LeadResult | null = null;
  $('[data-offer-view]')?.addEventListener('click', () => lastOffer && openDeck(lastOffer));

  // "Your run just now" under the measured results
  const showLiveRun = (r: LeadResult) => {
    $('[data-live-run]')!.hidden = false;
    $('[data-live-run-text]')!.textContent = `Your run just now: ${Math.max(1, Math.round(r.ms / 1000))} s from click to finished PDF, on the same production workflow.`;
  };

  const fillOffer = (live: LeadResult | null) => {
    lastOffer = live;
    const fallback = sampleResult();
    const roleId = live ? live.role : fallback.roleId;
    const r = roles.find((x) => x.id === roleId) ?? roles[0];
    // What we promise depends on the product in the offer: SaaS runs in our cloud, Vault in a private environment,
    // on-premise on the client's own servers. The sample offer (no live result) shows the on-premise promise.
    const product = live?.tiles?.find((t) => t.startsWith('product:')) || 'product:on-prem';
    const PRODUCT_LINE: Record<string, string> = {
      'product:saas': 'Gaius runs in the European Economic Area: your files are encrypted, you hold the keys, and documents are never used to train models.',
      'product:vault': 'Gaius Vault is a private environment: documents are never used to train models, with access set per team and matter.',
      'product:on-prem': 'Gaius Vault runs on your own servers, on local models, with post-quantum file encryption.',
    };
    const values: Record<string, string> = { who: live?.who || fallback.who, headline: r.headline, answer: r.answer, attach: r.attach, 'product-line': PRODUCT_LINE[product] || PRODUCT_LINE['product:on-prem'] };
    $$('[data-offer]').forEach((el) => (el.textContent = values[el.dataset.offer!] ?? ''));

    const concernsBox = $('[data-offer-concerns]');
    const tpl = $<HTMLTemplateElement>('[data-concern-tpl]');
    // Only concerns backed by the client's words are shown as "what you told us"; a default concern (n8n picks one when
    // the enquiry gives nothing) gets an honest heading, and an empty voice note says so instead.
    const u = live?.understood;
    const painsOf = (ids: string[]) => ids.map((id) => painLines([id])[0] || TILE_WORDS[id] || id);
    let concernsLabel = 'What you told us worries you';
    let concerns: string[] = live?.concerns?.length ? live.concerns : painLines(live?.tiles);
    if (live && u) {
      const said = (u.pains || []).filter((p) => p.id && saidWords(p)).map((p) => p.id!);
      if (state.mode === 'voice' && !heardText(u)) {
        concernsLabel = 'We did not hear your note';
        concerns = ['Nothing came through in the recording. Record it again a little closer to the microphone, or type your note with the pencil.'];
      } else if (said.length) {
        concerns = painsOf(said);
      } else {
        concernsLabel = 'Concerns teams like yours often raise';
        concerns = painsOf((live.tiles || []).filter((t) => t.startsWith('pain:')));
      }
    }
    $('[data-concerns-label]')!.textContent = concernsLabel;
    if (concerns.length && concernsBox && tpl) {
      const lines = concerns.map((c, i) => {
        const line = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        line.style.animationDelay = `${0.15 + i * 0.1}s`;
        line.querySelector('span')!.textContent = c;
        return line;
      });
      concernsBox.replaceChildren(...lines);
    }

    const tilesBox = $('[data-offer-tiles]')!;
    tilesBox.hidden = !live?.tiles?.length;
    tilesBox.replaceChildren(...(live?.tiles || []).map((t) => Object.assign(document.createElement('span'), { className: 'offer__tile', textContent: tileWord(t) })));

    showUnderstood(live?.understood);

    const note = $('[data-offer-note]')!;
    note.hidden = !live?.note;
    $('[data-offer-note-text]')!.textContent = live?.note || '';

    const pdf = $<HTMLAnchorElement>('[data-offer-pdf]');
    if (pdf) {
      const href = live?.pdfUrl || (live?.pdfPath ? `${N8N_ORIGIN}${live.pdfPath}` : '');
      if (href) pdf.href = href;
      else pdf.removeAttribute('href');
      // A blob: URL is downloaded as a file; a link on n8n opens in a new tab.
      if (live?.pdfUrl) pdf.download = live.fileName || 'Gaius-offer.pdf';
      else pdf.removeAttribute('download');
      pdf.setAttribute('aria-disabled', String(!live));
    }
    $('[data-offer-view]')!.hidden = !live?.pdfUrl;
    $('[data-offer-meta]')!.textContent = live
      ? `Generated in ${Math.max(1, Math.round(live.ms / 1000))} s · Offer Studio via n8n${live.known ? '' : ' · default offer, nothing known yet'}`
      : 'Generated in 2 min 41 s · sample data';
    $('[data-offer-saved]')!.textContent = live
      ? `Saved in Offer Studio as ${live.offerId} · CRM and #sales alert (mock)`
      : 'Saved to CRM · alert posted to #sales on Discord (mock)';
    if (live) showLiveRun(live);
  };

  const setBuildStep = (step: number) => {
    $$('[data-build-step]').forEach((el) => {
      const i = Number(el.dataset.buildStep);
      el.dataset.state = i < step ? 'done' : i === step ? 'active' : 'waiting';
    });
  };

  // One deck per answer is kept as a blob: URL; older ones are released.
  const deckUrls: string[] = [];
  const keepDeck = (blob: Blob) => {
    const url = URL.createObjectURL(blob);
    deckUrls.push(url);
    while (deckUrls.length > 2) URL.revokeObjectURL(deckUrls.shift()!);
    return url;
  };
  const header = (res: Response, name: string) => {
    const v = res.headers.get(name) || '';
    try { return decodeURIComponent(v); } catch { return v; }
  };

  // Posts one enquiry to the production workflow. It answers with the final deck (the PDF it also posts to Discord).
  const callWorkflow = async (body: object, fallbackWho: string, fallbackRole: string): Promise<LeadResult | null> => {
    const t0 = performance.now();
    try {
      const res = await fetch(OFFER_WEBHOOK_URL, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
        // n8n answers once the deck is rendered
        signal: AbortSignal.timeout(480_000),
      });
      if (!res.ok) throw new Error(`n8n ${res.status}`);
      if ((res.headers.get('content-type') || '').includes('application/pdf')) {
        const blob = await res.blob();
        const offerId = res.headers.get('x-offer-id') || '';
        const tiles = (res.headers.get('x-offer-tiles') || '').split(',').filter(Boolean);
        const fileName = /filename="?([^";]+)"?/.exec(res.headers.get('content-disposition') || '')?.[1];
        return {
          offerId,
          role: tiles.includes('role:board') ? 'board' : tiles.includes('role:champion') ? 'champion' : (fallbackRole as LeadResult['role']),
          who: header(res, 'x-offer-name') || fallbackWho,
          concerns: [],
          tiles,
          note: header(res, 'x-offer-note'),
          understood: (() => { try { return JSON.parse(header(res, 'x-offer-understood') || 'null') || undefined; } catch { return undefined; } })(),
          pdfUrl: keepDeck(blob),
          fileName: fileName || `Gaius-offer-${offerId || 'deck'}.pdf`,
          known: true,
          ms: performance.now() - t0,
        };
      }
      // Otherwise JSON: an acknowledgement, or a full offer from the local workflow.
      const data = (await res.json().catch(() => null)) as LeadResult | null;
      return data?.offerId ? { ...data, ms: data.ms ?? performance.now() - t0 } : null;
    } catch (e) {
      console.warn('Offer Studio via n8n unavailable, showing the sample offer.', e);
      return null;
    }
  };
  const requestOffer = () => {
    const f = sampleResult();
    return callWorkflow(leadPayload(), f.who, f.roleId);
  };

  $('[data-generate]')?.addEventListener('click', async () => {
    // "Paste a call" with nothing pasted: ask for the text instead of sending an empty enquiry.
    if (state.mode === 'text' && !callText()) {
      callBox.focus();
      callBox.placeholder = 'Paste an email or a transcript first, or click "Use a sample call".';
      return;
    }
    resetGen();
    const run = genRun;
    setBuildStep(0);
    showPhase('working');
    // Progress steps follow the demo rhythm; the last one waits for n8n.
    for (let n = 1; n < buildSteps.length; n++) genTimers.push(window.setTimeout(() => setBuildStep(n), n * 750));
    const minWait = new Promise((ok) => genTimers.push(window.setTimeout(ok, 3400)));
    // Still recording? Finish the note first so the audio goes with this click.
    if (session) stopRecording();
    await voiceReady;
    finishEditing();
    const [live] = await Promise.all([requestOffer(), minWait]);
    if (run !== genRun) return; // the selection changed meanwhile: the result is stale
    setBuildStep(buildSteps.length);
    fillOffer(live);
    showPhase('done');
  });

  /* ---------- Workflow n8n: a live run on the selected source's sample ---------- */
  let flowTimers: number[] = [];
  let flowRun = 0;
  let flowOffer: LeadResult | null = null;
  let currentSrc = sources.find((s) => s.id === $('[data-src][aria-pressed="true"]')?.dataset.src) ?? sources[0];
  const nodeCount = flowNodes.length + 1;
  const runBtn = $<HTMLButtonElement>('[data-run-flow]');
  const status = $('[data-flow-status]');

  const setFlow = (step: number, doneText = 'Finished · 1 offer') => {
    const done = step >= nodeCount;
    const running = step >= 0 && !done;
    $$('[data-node]').forEach((el) => {
      const i = Number(el.dataset.node);
      el.dataset.state = i < step ? 'done' : i === step ? 'active' : 'idle';
    });
    if (status) {
      status.dataset.state = done ? 'done' : running ? 'running' : 'waiting';
      $('[data-flow-status-text]')!.textContent = done ? doneText : running ? 'Running…' : 'Waiting for a trigger';
    }
    if (runBtn) {
      runBtn.classList.toggle('pulse', step < 0);
      runBtn.disabled = running;
      $('[data-run-flow-label]')!.textContent = done ? 'Run again' : running ? 'Running…' : 'Run the workflow';
    }
    $('[data-flow-empty]')!.hidden = done;
    $('[data-flow-out]')!.hidden = !done;
  };

  const stopFlow = () => {
    flowRun++;
    flowTimers.forEach(clearTimeout);
    flowTimers = [];
  };

  const showFlowResult = (r: LeadResult | null) => {
    flowOffer = r;
    $$('[data-flow-who]').forEach((el) => (el.textContent = r?.who || currentSrc.who));
    const tiles = $('[data-flow-tiles]')!;
    tiles.hidden = !r?.tiles?.length;
    tiles.textContent = r?.tiles?.length ? `Built from: ${r.tiles.map(tileWord).join(' · ')}` : '';
    const note = $('[data-flow-note]')!;
    note.hidden = !r?.note;
    note.textContent = r?.note || '';
    $('[data-flow-view]')!.hidden = !r?.pdfUrl;
  };
  $('[data-flow-view]')?.addEventListener('click', () => flowOffer && openDeck(flowOffer));

  const sourceButtons = $$<HTMLButtonElement>('[data-src]');
  sourceButtons.forEach((b) =>
    b.addEventListener('click', () => {
      stopFlow();
      currentSrc = sources.find((s) => s.id === b.dataset.src) ?? sources[0];
      sourceButtons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      $('[data-node-app]')!.textContent = currentSrc.label.toUpperCase();
      $('[data-node-label]')!.textContent = currentSrc.trigger;
      $('[data-node-icon] path')?.setAttribute('d', icons[currentSrc.icon]);
      $('[data-flow-source]')!.textContent = currentSrc.short;
      $('[data-flow-sample]')!.textContent = currentSrc.sample;
      showFlowResult(null);
      setFlow(-1);
    }),
  );

  runBtn?.addEventListener('click', async () => {
    stopFlow();
    const run = flowRun;
    const src = currentSrc;
    $('[data-flow-sample]')!.textContent = src.sample;
    setFlow(0);
    // The nodes light up while n8n works; the last two (CRM, Discord) wait for the real answer.
    for (let n = 1; n <= nodeCount - 2; n++) flowTimers.push(window.setTimeout(() => run === flowRun && setFlow(n), n * 1600));
    const live = await callWorkflow(
      { source: `demo-${src.id}`, mode: 'flow', touched: ['text'], text: src.sample, page: location.href, language: 'en', sentAt: new Date().toISOString() },
      src.who,
      'board',
    );
    if (run !== flowRun) return;
    flowTimers.forEach(clearTimeout);
    showFlowResult(live);
    setFlow(nodeCount - 1);
    flowTimers.push(window.setTimeout(() => {
      if (run !== flowRun) return;
      setFlow(nodeCount, live ? `Finished · 1 offer in ${Math.max(1, Math.round(live.ms / 1000))} s` : 'Finished · sample result (n8n did not answer)');
      if (live) showLiveRun(live);
    }, 600));
  });
</script>
