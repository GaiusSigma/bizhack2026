---
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  stroke?: string;
  strokeWidth?: number;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const { name, size = 20, stroke = 'currentColor', strokeWidth = 2, class: className, ...rest } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={stroke}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...rest}
><path d={icons[name]}></path></svg>
