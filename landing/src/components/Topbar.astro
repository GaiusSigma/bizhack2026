---
// Header shared by every page. On the home page the section links are anchors; elsewhere they lead back home.
import Icon from './Icon.astro';
interface Props { home?: boolean; current?: 'tech' | 'pitch' }
const { home = false, current } = Astro.props;
const to = (hash: string) => (home ? hash : `/${hash}`);
---
<header class="topbar">
  <div class="wrap topbar__inner">
    <div class="brand">
      <a class="wordmark" href={to('#generator')}>GAIUS-LEX</a>
      <span class="badge"><Icon name="spark" size={14} />BizHack AI · Challenge 07</span>
    </div>
    <nav class="nav" aria-label="Main">
      <a class="nav__link" href={to('#flow')}>How it runs</a>
      <a class="nav__link" href={to('#results')}>Results</a>
      <a class:list={['nav__link', { 'nav__link--current': current === 'tech' }]} href="/how-it-works" aria-current={current === 'tech' ? 'page' : undefined}>How it’s built</a>
      <a class="btn btn--ink nudge" href={to('#generator')}>Get your offer<Icon name="arrow" size={16} /></a>
    </nav>
  </div>
</header>
