---
interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'Gaius-Lex · BizHack 2026', lang = 'en' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d1f21" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Tokeny Gaius-Lex (strona marketingowa: tylko jasny motyw). */
  :root {
    --ink: #1d1f21;
    --body: #404449;
    --muted: #6f737a;
    --surface: #ffffff;
    --sand: #faf8f5;
    --line: #e7e1d7;
    --parchment: #cebfa6;
    --rose: #ce5e64;
    --rose-deep: #9b5155;
    --rose-solid: #b4585c;
    --burgundy: #693d40;
    --rose-soft: #f7edec;
    --raised: #2a2d30;
    --rose-on-ink: #e9868c;
    --rose-soft-on-ink: #e9a0a4;
    --check: #2e7d46;
    --check-on-ink: #7fd79a;
    --font: 'Figtree', -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  html, body { margin: 0; }
  body {
    background: var(--surface);
    color: var(--body);
    font: 16px/1.5 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--rose-deep); }
  a:hover { color: var(--burgundy); }
  button, input { font-family: inherit; }
  :focus-visible { outline: 2px solid var(--rose); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
