# Tylko do uruchamiania LOKALNEGO. Skopiuj do .env i zmień hasła.
# W Coolify tych zmiennych nie ustawiasz: SERVICE_* generuje sam Coolify,
# a adresy bierze z domen przypisanych do usług.

# Publiczne adresy usług (w Coolify: domeny usług)
SERVICE_URL_LANDING=http://localhost:8080
SERVICE_URL_N8N=http://localhost:5678
SERVICE_URL_FIGCRAFT=http://localhost:8081
SERVICE_URL_OFFER_STUDIO=http://localhost:8082

# Dane logowania (w Coolify generowane automatycznie)
SERVICE_USER_POSTGRES=n8n
SERVICE_PASSWORD_POSTGRES=zmien-mnie-postgres
SERVICE_PASSWORD_N8NRUNNERS=zmien-mnie-runners
# Klucz szyfrowania poświadczeń n8n: NIE zmieniaj go po pierwszym starcie
SERVICE_PASSWORD_64_N8NKEY=zmien-mnie-na-dlugi-losowy-klucz-szyfrowania-n8n

# Offer Studio: hasło do przeglądarki, token API, klucz podpisu linków do renderu PDF
SERVICE_PASSWORD_STUDIO=studio
SERVICE_PASSWORD_64_STUDIOAPI=zmien-mnie-token-api-offer-studio
SERVICE_PASSWORD_64_STUDIOSECRET=zmien-mnie-sekret-offer-studio

# Opcjonalne
POSTGRES_DB=n8n
GENERIC_TIMEZONE=Europe/Warsaw
TZ=Europe/Warsaw
FIGCRAFT_OPEN_PUBLISH=false
FIGCRAFT_TEAM_FILES=
FIGCRAFT_MAX_FILE_MB=64
