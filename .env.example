# For LOCAL runs only. Copy to .env and change the passwords.
# You don't set these in Coolify: Coolify generates SERVICE_* itself
# and takes the URLs from the domains assigned to the services.

# Public service URLs (in Coolify: the service domains)
SERVICE_URL_LANDING=http://localhost:8080
SERVICE_URL_N8N=http://localhost:5678
SERVICE_URL_FIGCRAFT=http://localhost:8081
SERVICE_URL_OFFER_STUDIO=http://localhost:8082

# Credentials (generated automatically in Coolify)
SERVICE_USER_POSTGRES=n8n
SERVICE_PASSWORD_POSTGRES=change-me-postgres
SERVICE_PASSWORD_N8NRUNNERS=change-me-runners
# n8n credential encryption key: do NOT change it after the first start
SERVICE_PASSWORD_64_N8NKEY=change-me-to-a-long-random-n8n-encryption-key

# Offer Studio: Claude API key for AI card picking (optional; set it by hand in Coolify)
ANTHROPIC_API_KEY=

# Offer Studio: browser password and API token
SERVICE_PASSWORD_STUDIO=studio
SERVICE_PASSWORD_64_STUDIOAPI=change-me-offer-studio-api-token
# OpenRouter key for the AI models in the n8n offer workflows (optional; without it the AI steps fail).
OPENROUTER_API_KEY=

# Optional
POSTGRES_DB=n8n
GENERIC_TIMEZONE=Europe/Warsaw
TZ=Europe/Warsaw
FIGCRAFT_OPEN_PUBLISH=false
FIGCRAFT_TEAM_FILES=
FIGCRAFT_MAX_FILE_MB=64
